<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog title="{i18n>cancelOrder}" contentWidth="32rem" stretchOnPhone="true">
        <content>
            <VBox class="sapUiContentPadding">
                <Label text="{i18n>cancellationReason}" labelFor="cancellationReason" required="true" />
                <TextArea
                    id="cancellationReason"
                    value="{ui>/cancellationReason}"
                    rows="4"
                    maxLength="300"
                    width="100%" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>confirm}" type="Emphasized" press=".onConfirmCancel" />
        </beginButton>
        <endButton>
            <Button text="{i18n>close}" press=".onCloseCancel" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
