<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m">
    <Dialog title="{i18n>editOrder}" contentWidth="36rem" stretchOnPhone="true">
        <content>
            <VBox class="sapUiContentPadding">
                <Label text="{i18n>customer}" labelFor="editCustomer" required="true" />
                <Select
                    id="editCustomer"
                    selectedKey="{ui>/editOrder/customerID}"
                    items="{/Customers}"
                    width="100%">
                    <core:Item key="{ID}" text="{displayName}" />
                </Select>
                <Label text="{i18n>discount}" labelFor="editDiscount" class="sapUiSmallMarginTop" />
                <Input
                    id="editDiscount"
                    type="Number"
                    value="{ui>/editOrder/discountAmount}" />
                <Label text="{i18n>note}" labelFor="editNote" class="sapUiSmallMarginTop" />
                <TextArea
                    id="editNote"
                    value="{ui>/editOrder/note}"
                    rows="4"
                    maxLength="300"
                    width="100%" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onSaveEdit" />
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onCloseEdit" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
