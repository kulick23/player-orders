<mvc:View
    controllerName="playerorders.orders.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns="sap.m"
    displayBlock="true">
    <VBox class="ordersShell" fitContainer="true">
        <OverflowToolbar class="ordersTopBar">
            <Title text="PLAYER ORDERS" level="H1" class="ordersBrand" />
            <ToolbarSpacer />
            <Text text="{i18n>administrator}" class="ordersUserRole" />
            <Avatar initials="PO" displaySize="XS" backgroundColor="Accent6" />
        </OverflowToolbar>

        <HBox class="ordersWorkspace" fitContainer="true">
            <VBox fitContainer="true" class="ordersSidebar">
                <tnt:SideNavigation id="sideNavigation" expanded="true" class="ordersSideNavigation" itemSelect=".onItemSelect">
                    <tnt:layoutData>
                        <FlexItemData growFactor="1" baseSize="0" />
                    </tnt:layoutData>
                    <tnt:NavigationList selectedKey="orders">
                        <tnt:NavigationListItem key="orders" text="{i18n>orders}" icon="sap-icon://sales-order" />
                    </tnt:NavigationList>
                </tnt:SideNavigation>
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="ordersSidebarFooter">
                    <Text text="{i18n>language}" />
                    <Switch
                        state="{ui>/isEnglish}"
                        customTextOn="EN"
                        customTextOff="RU"
                        tooltip="{i18n>changeLanguage}"
                        change=".onLanguageChange" />
                </HBox>
            </VBox>

            <App id="app" busy="{ui>/busy}" class="ordersContent">
                <layoutData>
                    <FlexItemData growFactor="1" baseSize="0" />
                </layoutData>
            </App>
        </HBox>
    </VBox>
</mvc:View>
