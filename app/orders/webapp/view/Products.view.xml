<mvc:View
    controllerName="playerorders.orders.controller.Products"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page showHeader="false" class="ordersPage">
        <content>
            <VBox class="ordersPageContent">
                <Title text="{i18n>productsPageTitle}" level="H1" class="ordersHeroTitle" />
                <Text text="{i18n>productsPageSubtitle}" class="ordersSubtitle" />

                <FlexBox wrap="Wrap" class="inventorySummary">
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/totalProducts}" />
                        <Text text="{i18n>totalProducts}" />
                    </VBox>
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/activeProducts}" state="Success" />
                        <Text text="{i18n>activeProducts}" />
                    </VBox>
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/trackedProducts}" />
                        <Text text="{i18n>trackedProducts}" />
                    </VBox>
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/totalStockUnits}" />
                        <Text text="{i18n>totalStockUnits}" />
                    </VBox>
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/lowStockProducts}" state="Warning" />
                        <Text text="{i18n>lowStockProducts}" />
                    </VBox>
                    <VBox class="inventorySummaryItem">
                        <ObjectNumber number="{ui>/inventorySummary/outOfStockProducts}" state="Error" />
                        <Text text="{i18n>outOfStockProducts}" />
                    </VBox>
                </FlexBox>

                <FlexBox wrap="Wrap" alignItems="Center" class="ordersPrimaryActions">
                    <SearchField
                        value="{ui>/productSearch}"
                        placeholder="{i18n>searchProducts}"
                        liveChange=".onSearch"
                        search=".onSearch"
                        class="ordersSearch">
                        <layoutData>
                            <FlexItemData growFactor="1" baseSize="24rem" />
                        </layoutData>
                    </SearchField>
                    <Button
                        icon="sap-icon://add"
                        text="{i18n>createProduct}"
                        type="Emphasized"
                        visible="{ui>/capabilities/canCreateProduct}"
                        press=".onOpenCreate"
                        class="ordersCreateButton" />
                    <Button icon="sap-icon://refresh" type="Transparent" tooltip="{i18n>refresh}" press=".onRefresh" />
                </FlexBox>

                <VBox class="ordersCard">
                    <Table id="productsTable" items="{/GameProducts}" growing="true" growingThreshold="20">
                        <headerToolbar>
                            <OverflowToolbar>
                                <Title text="{i18n>products}" level="H2" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <columns>
                            <Column width="20rem"><Text text="{i18n>productName}" /></Column>
                            <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>productType}" /></Column>
                            <Column width="8rem" hAlign="End"><Text text="{i18n>price}" /></Column>
                            <Column width="10rem"><Text text="{i18n>stockRelevant}" /></Column>
                            <Column width="8rem" hAlign="End"><Text text="{i18n>stockQuantity}" /></Column>
                            <Column width="8rem"><Text text="{i18n>status}" /></Column>
                            <Column width="16rem" hAlign="End" />
                        </columns>
                        <items>
                            <ColumnListItem>
                                <cells>
                                    <HBox alignItems="Center" class="productIdentity">
                                        <Avatar
                                            displayShape="Square"
                                            displaySize="M"
                                            icon="sap-icon://product"
                                            src="{parts: ['ID', 'imageType', 'modifiedAt'], formatter: '.formatProductImageUrl'}"
                                            class="productImage" />
                                        <ObjectIdentifier title="{name}" text="{description}" />
                                    </HBox>
                                    <Text text="{type}" />
                                    <ObjectNumber number="{price}" />
                                    <VBox>
                                        <ObjectStatus text="{i18n>tracked}" state="Information" visible="{stockRelevant}" />
                                        <ObjectStatus text="{i18n>notTracked}" visible="{= !${stockRelevant} }" />
                                    </VBox>
                                    <HBox justifyContent="End">
                                        <ObjectNumber number="{stockQuantity}" emphasized="true" visible="{stockRelevant}" />
                                        <Text text="—" visible="{= !${stockRelevant} }" />
                                    </HBox>
                                    <VBox>
                                        <ObjectStatus text="{path: 'stockStatus', formatter: '.formatStockStatusText'}" state="{path: 'stockStatus', formatter: '.formatter.stockState'}" />
                                    </VBox>
                                    <HBox justifyContent="End">
                                        <Button
                                            icon="sap-icon://picture"
                                            tooltip="{i18n>uploadProductImage}"
                                            visible="{ui>/capabilities/canManageProductImage}"
                                            press=".onOpenImageUpload"
                                            class="sapUiTinyMarginEnd" />
                                        <Button
                                            icon="sap-icon://add-product"
                                            text="{i18n>replenishStock}"
                                            visible="{ui>/capabilities/canReplenishStock}"
                                            enabled="{stockRelevant}"
                                            press=".onOpenReplenish" />
                                    </HBox>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
